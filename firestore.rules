rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // POMO Clock: one explicitly authorized, verified Google account only.
    // Each document is also scoped to the authenticated user's Firebase UID.
    match /users/{userId}/privateData/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == 'drparuls580@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
